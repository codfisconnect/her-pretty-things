# ==================================================
# Her Pretty Things - Backend Environment Template
# Note: Use placeholders only. Never commit real credentials.
# ==================================================

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/her_pretty_things?schema=public"

# Cloudinary Configuration (Required for product and scoop media storage)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Razorpay Configuration (Use TEST credentials for local development)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Admin & Session Authentication
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-development-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Email & Notification Configuration (SMTP / Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
OWNER_NOTIFICATION_EMAIL=""

# Instagram Graph API Configuration (Optional: for live feed integration)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID="28158774550411939"